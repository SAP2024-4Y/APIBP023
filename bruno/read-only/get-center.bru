meta {
  name: Get Exam Center by ID
  type: http
  seq: 5
}

# Fetch a single exam center by its ID.
# Seeded center IDs: ctr-001 (Delhi), ctr-002 (Mumbai), ctr-003 (Bangalore), ctr-004 (Chennai), ctr-005 (Kolkata)

get {
  url: {{base_url}}/api/v1/exam-centers/ctr-003
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.city: isDefined
  res.body.coordinates: isDefined
}
