meta {
  name: Create Exam (Instructor)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/exams
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "title": "Sample Entrance Exam",
    "subject": "General Knowledge",
    "description": "A sample exam created via Bruno",
    "total_marks": 100,
    "passing_marks": 40,
    "duration_minutes": 90,
    "fee": 250,
    "status": "scheduled"
  }
}

script:post-response {
  if (res.body.id) {
    bru.setEnvVar("created_exam_id", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}
