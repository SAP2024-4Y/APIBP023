meta {
  name: Registration Detail
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/results/registrations/{{reg_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{student_token}}
}

assert {
  res.status: eq 200
  res.body.score: isDefined
  res.body.grade: isDefined
  res.body.questions: isDefined
}
