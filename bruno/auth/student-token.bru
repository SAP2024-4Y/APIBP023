meta {
  name: Get Student Token
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/token
  body: json
  auth: none
}

body:json {
  {
    "username": "demo",
    "password": "demo-password"
  }
}

script:post-response {
  bru.setVar("student_token", res.body.token);
  bru.setEnvVar("student_token", res.body.token);
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}
