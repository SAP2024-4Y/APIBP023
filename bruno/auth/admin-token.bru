meta {
  name: Get Admin Token
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/token
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin-password"
  }
}

script:post-response {
  bru.setVar("admin_token", res.body.token);
  bru.setEnvVar("admin_token", res.body.token);
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}
