meta {
  name: Login with Wrong Password
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/auth/token
  body: json
  auth: none
}

body:json {
  {
    "username": "demo",
    "password": "totally-wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.detail.code: eq INVALID_CREDENTIALS
}
