meta {
  name: Register for Slot-001
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/exam-slots/slot-001/register
  body: none
  auth: bearer
}

auth:bearer {
  token: {{student_token}}
}

script:post-response {
  bru.setVar("reg_id", res.body.id);
  bru.setEnvVar("reg_id", res.body.id);
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.status: eq registered
}
