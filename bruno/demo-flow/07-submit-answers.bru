meta {
  name: 07 - Submit Answers
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/submissions/{{demo_reg_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{student_token}}
}

body:json {
  {
    "answers": [
      { "question_id": "{{demo_q1_id}}", "answer": "B" },
      { "question_id": "{{demo_q2_id}}", "answer": "366" }
    ]
  }
}

script:post-response {
  bru.setVar("demo_script_id", res.body.id);
  bru.setEnvVar("demo_script_id", res.body.id);
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.evaluated: eq false
  res.body.answer_count: eq 2
}
