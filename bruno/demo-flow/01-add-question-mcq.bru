meta {
  name: 01 - Add MCQ Question
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/evaluation/exams/{{demo_exam_id}}/questions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "number": 1,
    "text": "Which planet is closest to the Sun?",
    "question_type": "mcq",
    "options": ["Venus", "Mercury", "Mars", "Earth"]
  }
}

script:post-response {
  bru.setVar("demo_q1_id", res.body.id);
  bru.setEnvVar("demo_q1_id", res.body.id);
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}
