meta {
  name: 03 - Set Answer Key Q1
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/evaluation/questions/{{demo_q1_id}}/answer-key
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "correct_answer": "B",
    "explanation": "Mercury is the closest planet to the Sun"
  }
}

assert {
  res.status: eq 201
  res.body.correct_answer: eq B
}
