# Copy this file to .env and fill in your values before running in production.
# docker compose reads .env automatically from the project root.

# REQUIRED in production — replace with a long random string.
# Generate one with: openssl rand -hex 32
SECRET_KEY=exam-eval-super-secret-key-change-in-prod-2024

# Database URL.
# Default: SQLite (fine for local dev, single-node only).
# Production: use PostgreSQL — add a postgres service to docker-compose.yml
#   and set: DATABASE_URL=postgresql+asyncpg://user:password@db:5432/examdb
DATABASE_URL=sqlite+aiosqlite:///./data/exam_eval.db

# Port the API server listens on inside the container.
PORT=8080
